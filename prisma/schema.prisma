// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  accounts      Account[]
  sessions      Session[]
  memories      Memory[]
  tokens        CapabilityToken[]
  approvals     Approval[]
  ledgerEntries ActionLedger[]
  killSwitch    Boolean   @default(false)
  projects      Project[]
  agents        Agent[]
  chatThreads   ChatThread[]
  chatMessages  ChatMessage[]
  workItems     WorkItem[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Memory {
  id        String   @id @default(cuid())
  userId    String
  key       String
  value     String
  createdAt DateTime @default(now())
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([userId, key])
}

model Agent {
  id           String   @id @default(cuid())
  userId       String
  projectId    String?
  name         String
  title        String?
  description  String
  instructions String?
  avatarColor  String   @default("#2DD4BF")
  avatarShape  String   @default("circle")
  status       String   @default("active")
  capabilities String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  project       Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  tokens        CapabilityToken[]
  ledgerEntries ActionLedger[]
  teamMembers   TeamMember[]
  chatThreads   ChatThread[]
  chatMessages  ChatMessage[]
  workItems     WorkItem[]
  
  @@unique([userId, name])
}

model CapabilityToken {
  id        String   @id @default(cuid())
  userId    String
  agentId   String
  scopes    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  revokedAt DateTime?
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  approvals Approval[]
}

model Approval {
  id        String   @id @default(cuid())
  userId    String
  tokenId   String
  action    String
  scope     String
  metadata  String?
  status    String   @default("pending")
  createdAt DateTime @default(now())
  resolvedAt DateTime?
  
  user  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  token CapabilityToken @relation(fields: [tokenId], references: [id], onDelete: Cascade)
}

model ActionLedger {
  id              String   @id @default(cuid())
  userId          String
  agentId         String?
  action          String
  scope           String
  metadata        String?
  result          String?
  timestamp       DateTime @default(now())
  delegationChain String?  @default("[]")
  toolArgsHash    String?
  hitl            Boolean  @default(false)
  
  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  agent Agent? @relation(fields: [agentId], references: [id], onDelete: SetNull)
}

model Contact {
  id        String   @id @default(cuid())
  name      String
  email     String
  company   String?
  message   String
  createdAt DateTime @default(now())
}

model Project {
  id          String   @id @default(cuid())
  userId      String
  name        String
  slug        String
  description String?
  details     String?
  color       String   @default("#2DD4BF")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  teams       Team[]
  agents      Agent[]
  chatThreads ChatThread[]
  workItems   WorkItem[]
  
  @@unique([userId, slug])
}

model Team {
  id          String   @id @default(cuid())
  projectId   String?
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  project     Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  members     TeamMember[]
  chatThreads ChatThread[]
}

model TeamMember {
  id        String   @id @default(cuid())
  teamId    String
  agentId   String
  role      String   @default("member")
  createdAt DateTime @default(now())
  
  team  Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  
  @@unique([teamId, agentId])
}

model ChatThread {
  id        String   @id @default(cuid())
  userId    String
  projectId String?
  agentId   String?
  teamId    String?
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  project  Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  agent    Agent?        @relation(fields: [agentId], references: [id], onDelete: SetNull)
  team     Team?         @relation(fields: [teamId], references: [id], onDelete: SetNull)
  messages ChatMessage[]
}

model ChatMessage {
  id        String   @id @default(cuid())
  threadId  String
  userId    String
  agentId   String?
  role      String
  content   String
  createdAt DateTime @default(now())
  
  thread ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  agent  Agent?     @relation(fields: [agentId], references: [id], onDelete: SetNull)
}

model WorkItem {
  id          String   @id @default(cuid())
  userId      String
  projectId   String?
  agentId     String?
  threadId    String?
  title       String
  description String?
  status      String   @default("pending")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  agent   Agent?   @relation(fields: [agentId], references: [id], onDelete: SetNull)
}
